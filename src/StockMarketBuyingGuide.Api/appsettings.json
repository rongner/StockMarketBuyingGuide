{
  "ConnectionStrings": {
    "Default": ""
  },
  "App": {
    "AllowedEmail": "",
    "ClaudeApiKey": "",
    "NewsApiKey": "",
    "CorsOrigins": [],
    "Jwt": {
      "Secret": "",
      "ExpiryHours": 8
    },
    "Google": {
      "ClientId": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
